# ── Branding ──────────────────────────────────────────────
BRAND_NAME=My Newsletter
BRAND_URL=https://example.com
BRAND_COLOR=#4f46e5
# Single character shown in the logo badge (defaults to first letter of BRAND_NAME)
BRAND_LOGO_LETTER=
# CTA button in emails
CTA_TEXT=Read More →
# Optional secondary link (e.g. YouTube channel). Leave blank to hide.
SECONDARY_URL=
SECONDARY_LABEL=▶ YouTube
# Footer text (supports {{BRAND_URL}} placeholder)
FOOTER_TEXT=You subscribed at {{BRAND_URL}} · Unsubscribe? Reply to this email.

# ── Resend ────────────────────────────────────────────────
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Your sending email (must be a verified domain in Resend)
FROM_EMAIL=Newsletter <updates@example.com>

# ── Google Sheets ─────────────────────────────────────────
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_SHEET_RANGE=Sheet1!A:C

# Google Service Account (from JSON key file)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# ── Server ────────────────────────────────────────────────
PORT=3000
